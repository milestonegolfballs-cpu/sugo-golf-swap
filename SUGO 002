                <tr key={r.id} className="border-t border-border">
                  <Td>
                    <div className="flex items-center gap-3">
                      <img src={r.photos?.[0] ?? ""} alt="" loading="lazy" className="h-10 w-10 rounded-lg bg-muted object-cover" />
